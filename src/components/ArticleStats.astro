---
interface Props {
  slug: string
}
const { slug } = Astro.props
---

<div class="article-stats" id="article-stats" data-slug={slug}>
  <span class="stats-views">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
      <circle cx="12" cy="12" r="3"/>
    </svg>
    <span id="view-count">—</span>
  </span>

  <button class="stats-like" id="like-btn" aria-label="Поставити лайк" type="button">
    <svg id="like-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
    </svg>
    <span id="like-count">—</span>
  </button>
</div>

<style>
  .article-stats {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .stats-views {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    color: var(--color-muted);
  }

  .stats-like {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    color: var(--color-muted);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: color 0.15s;
    font-family: inherit;
  }

  .stats-like:hover {
    color: #e74c3c;
  }

  .stats-like.liked {
    color: #e74c3c;
  }

  .stats-like.liked svg {
    fill: #e74c3c;
    stroke: #e74c3c;
  }
</style>

<script>
  const el = document.getElementById('article-stats');
  if (el) {
    const slug = el.dataset.slug!;
    const viewEl = document.getElementById('view-count');
    const likeEl = document.getElementById('like-count');
    const likeBtn = document.getElementById('like-btn') as HTMLButtonElement;
    const likedKey = `liked:${slug}`;
    const viewedKey = `viewed:${slug}`;

    // Restore liked state
    if (localStorage.getItem(likedKey)) {
      likeBtn?.classList.add('liked');
    }

    // Fetch current stats
    fetch(`/api/stats/${slug}`)
      .then(r => r.json())
      .then((data: { views: number; likes: number }) => {
        if (viewEl) viewEl.textContent = formatNum(data.views);
        if (likeEl) likeEl.textContent = formatNum(data.likes);
      })
      .catch(() => {
        if (viewEl) viewEl.textContent = '';
        if (likeEl) likeEl.textContent = '';
      });

    // Count view — once per session per article
    if (!sessionStorage.getItem(viewedKey)) {
      sessionStorage.setItem(viewedKey, '1');
      fetch(`/api/view/${slug}`, { method: 'POST' })
        .then(r => r.json())
        .then((data: { views: number }) => {
          if (viewEl) viewEl.textContent = formatNum(data.views);
        })
        .catch(() => {});
    }

    // Like button
    likeBtn?.addEventListener('click', async () => {
      if (localStorage.getItem(likedKey)) return;
      likeBtn.disabled = true;
      try {
        const r = await fetch(`/api/like/${slug}`, { method: 'POST' });
        const data: { likes: number } = await r.json();
        if (likeEl) likeEl.textContent = formatNum(data.likes);
        likeBtn.classList.add('liked');
        localStorage.setItem(likedKey, '1');
      } finally {
        likeBtn.disabled = false;
      }
    });
  }

  function formatNum(n: number): string {
    if (n >= 1000) return (n / 1000).toFixed(1).replace('.0', '') + 'k';
    return String(n);
  }
</script>
