---
import type { Article } from '../lib/notion'

interface Props {
  article: Article
  priority?: boolean
}

const { article, priority = false } = Astro.props

const articleDate = article.date || article.createdAt
const date = new Date(articleDate).toLocaleDateString('uk-UA', {
  year: 'numeric', month: 'long', day: 'numeric'
})
---

<a
  href={`/articles/${article.slug}`}
  class="article-card"
>
  <!-- Image -->
  <div class="card-image">
    {article.image ? (
      <img
        src={article.image.card}
        alt={article.image.alt ?? article.title}
        width="640"
        height="384"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
      />
    ) : (
      <div class="card-image-placeholder">
        <span>✦</span>
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="card-body">
    {article.category && (
      <span class="card-category">{article.category}</span>
    )}

    <h3 class="card-title">{article.title}</h3>

    {article.description && (
      <p class="card-description">{article.description}</p>
    )}

    <div class="card-meta">
      <time datetime={articleDate}>{date}</time>
      {article.readTime && (
        <>
          <span class="meta-dot">·</span>
          <span>{article.readTime} хв</span>
        </>
      )}
      <span class="card-stats" data-card-stats={article.slug}>
        <span class="card-stat">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          <span data-cv>—</span>
        </span>
        <span class="card-stat">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span data-cl>—</span>
        </span>
      </span>
    </div>
  </div>
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    background: var(--color-card);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    overflow: hidden;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .article-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
  }

  .card-image {
    width: 100%;
    aspect-ratio: 5 / 3;
    overflow: hidden;
    background: linear-gradient(135deg, #e8e6ff 0%, #f0eeff 100%);
    flex-shrink: 0;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .article-card:hover .card-image img {
    transform: scale(1.03);
  }

  .card-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    opacity: 0.3;
  }

  .card-body {
    padding: 20px 24px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-category {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 8px;
    display: block;
  }

  .card-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.35;
    margin: 0 0 8px;
  }

  .card-description {
    font-size: 13px;
    color: var(--color-secondary);
    line-height: 1.5;
    margin: 0 0 16px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--color-muted);
    margin-top: auto;
  }

  .meta-dot {
    color: var(--color-border);
  }

  .card-stats {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .card-stat {
    display: flex;
    align-items: center;
    gap: 3px;
    font-size: 11px;
    color: var(--color-muted);
  }
</style>

<script>
  function fmt(n: number): string {
    if (n >= 1000) return (n / 1000).toFixed(1).replace('.0', '') + 'k';
    return String(n);
  }

  document.querySelectorAll<HTMLElement>('[data-card-stats]').forEach(el => {
    const slug = el.dataset.cardStats!;
    fetch(`/api/stats/${slug}`)
      .then(r => r.json())
      .then((data: { views: number; likes: number }) => {
        const vc = el.querySelector('[data-cv]');
        const lc = el.querySelector('[data-cl]');
        if (vc) vc.textContent = fmt(data.views);
        if (lc) lc.textContent = fmt(data.likes);
      })
      .catch(() => {
        el.style.display = 'none';
      });
  });
</script>
